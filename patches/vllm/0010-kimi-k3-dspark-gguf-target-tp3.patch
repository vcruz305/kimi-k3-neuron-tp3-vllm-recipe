+    @staticmethod
+    def _pad_k3_dspark_for_tp(
+        draft_model_config: ModelConfig,
+        draft_tensor_parallel_size: int,
+    ) -> None:
+        """Pad K3 DSpark heads and MLP width for otherwise-incompatible TP."""
+        if draft_tensor_parallel_size <= 1:
+            return
+
+        hf_config = draft_model_config.hf_config
+        checkpoint_num_heads = getattr(
+            hf_config,
+            "_vllm_checkpoint_num_attention_heads",
+            hf_config.num_attention_heads,
+        )
+        checkpoint_intermediate_size = getattr(
+            hf_config,
+            "_vllm_checkpoint_intermediate_size",
+            hf_config.intermediate_size,
+        )
+
+        def align_up(value: int) -> int:
+            return (
+                (value + draft_tensor_parallel_size - 1)
+                // draft_tensor_parallel_size
+                * draft_tensor_parallel_size
+            )
+
+        padded_num_heads = align_up(checkpoint_num_heads)
+        padded_intermediate_size = align_up(checkpoint_intermediate_size)
+        if (
+            padded_num_heads == checkpoint_num_heads
+            and padded_intermediate_size == checkpoint_intermediate_size
+        ):
+            return
+
+        hf_config._vllm_checkpoint_num_attention_heads = checkpoint_num_heads
+        hf_config._vllm_checkpoint_intermediate_size = checkpoint_intermediate_size
+        hf_config.num_attention_heads = padded_num_heads
+        hf_config.intermediate_size = padded_intermediate_size
+        draft_model_config.model_arch_config.total_num_attention_heads = (
+            padded_num_heads
+        )
+        logger.warning(
+            "Padding K3 DSpark for TP%d: attention heads %d -> %d and "
+            "intermediate size %d -> %d. Checkpoint weights for the added "
+            "dimensions are zero-filled during loading.",
+            draft_tensor_parallel_size,
+            checkpoint_num_heads,
+            padded_num_heads,
+            checkpoint_intermediate_size,
+            padded_intermediate_size,
+        )
+
