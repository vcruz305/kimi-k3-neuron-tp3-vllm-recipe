+def _zero_pad_dimension(
+    weight: torch.Tensor,
+    *,
+    dimension: int,
+    checkpoint_size: int,
+    padded_size: int,
+    name: str,
+) -> torch.Tensor:
+    current_size = weight.shape[dimension]
+    if current_size == padded_size:
+        return weight
+    if current_size != checkpoint_size:
+        raise ValueError(
+            f"Cannot TP-pad {name}: expected dimension {dimension} to have "
+            f"size {checkpoint_size}, got {current_size}."
+        )
+    pad_shape = list(weight.shape)
+    pad_shape[dimension] = padded_size - checkpoint_size
+    return torch.cat((weight, weight.new_zeros(pad_shape)), dim=dimension)
+
+
+def _pad_k3_dspark_tp_weights(
+    weights: Iterable[tuple[str, torch.Tensor]], config
+) -> Iterable[tuple[str, torch.Tensor]]:
+    """Zero-pad released K3 DSpark weights to the runtime TP geometry."""
+    checkpoint_num_heads = getattr(
+        config, "_vllm_checkpoint_num_attention_heads", config.num_attention_heads
+    )
+    checkpoint_intermediate_size = getattr(
+        config, "_vllm_checkpoint_intermediate_size", config.intermediate_size
+    )
+    padded_num_heads = config.num_attention_heads
+    padded_intermediate_size = config.intermediate_size
+    qk_head_dim = config.qk_nope_head_dim + config.qk_rope_head_dim
+    kv_head_dim = config.qk_nope_head_dim + config.v_head_dim
+
+    for name, weight in weights:
+        if name.endswith((".self_attn.q_b_proj.weight", ".self_attn.q_proj.weight")):
+            weight = _zero_pad_dimension(
+                weight,
+                dimension=0,
+                checkpoint_size=checkpoint_num_heads * qk_head_dim,
+                padded_size=padded_num_heads * qk_head_dim,
+                name=name,
+            )
+        elif name.endswith(".self_attn.kv_b_proj.weight"):
+            weight = _zero_pad_dimension(
+                weight,
+                dimension=0,
+                checkpoint_size=checkpoint_num_heads * kv_head_dim,
+                padded_size=padded_num_heads * kv_head_dim,
+                name=name,
+            )
+        elif name.endswith(".self_attn.o_proj.weight"):
+            weight = _zero_pad_dimension(
+                weight,
+                dimension=1,
+                checkpoint_size=checkpoint_num_heads * config.v_head_dim,
+                padded_size=padded_num_heads * config.v_head_dim,
+                name=name,
+            )
+        elif name.endswith((".mlp.gate_proj.weight", ".mlp.up_proj.weight")):
+            weight = _zero_pad_dimension(
+                weight,
+                dimension=0,
+                checkpoint_size=checkpoint_intermediate_size,
+                padded_size=padded_intermediate_size,
+                name=name,
+            )
+        elif name.endswith(".mlp.down_proj.weight"):
+            weight = _zero_pad_dimension(
+                weight,
+                dimension=1,
+                checkpoint_size=checkpoint_intermediate_size,
+                padded_size=padded_intermediate_size,
+                name=name,
+            )
+        elif name.endswith(".mlp.gate_up_proj.weight"):
+            gate, up = weight.split(checkpoint_intermediate_size, dim=0)
+            gate = _zero_pad_dimension(
+                gate,
+                dimension=0,
+                checkpoint_size=checkpoint_intermediate_size,
+                padded_size=padded_intermediate_size,
+                name=name,
+            )
+            up = _zero_pad_dimension(
+                up,
+                dimension=0,
+                checkpoint_size=checkpoint_intermediate_size,
+                padded_size=padded_intermediate_size,
+                name=name,
+            )
+            weight = torch.cat((gate, up), dim=0)
+        yield name, weight
+
