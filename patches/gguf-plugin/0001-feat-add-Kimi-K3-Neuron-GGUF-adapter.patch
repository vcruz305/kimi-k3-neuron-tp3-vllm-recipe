@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from types import SimpleNamespace
+
+import torch
+
+from vllm_gguf_plugin.quantization.fused_moe import _situ_activation_config
+from vllm_gguf_plugin.weights_adapter.base import GGUFLoadSpec
+from vllm_gguf_plugin.weights_adapter.kimi_k3 import KimiK3NeuronGGUFAdapter
+
+
+class _Config(SimpleNamespace):
+    def get_text_config(self):
+        return self
+
+
+def _config():
+    return _Config(
+        model_type="kimi_linear",
+        num_hidden_layers=2,
+        first_k_dense_replace=1,
+        linear_attn_config={"kda_layers": [1], "full_attn_layers": [2]},
+        attn_res_block_size=12,
+        routed_expert_hidden_size=3584,
+        hidden_act="situ",
+    )
+
+
+def test_kimi_k3_static_name_map_covers_special_paths():
+    mapping = KimiK3NeuronGGUFAdapter.build_name_map(_config())
+    assert mapping["blk.0.ssm_g.weight"] == "model.layers.0.self_attn.g_proj.weight"
+    assert mapping["blk.0.ssm_a"] == "model.layers.0.self_attn.A_log"
+    assert mapping["blk.1.attn_k_b.weight"] == "__k3_kvb__.1.k.weight"
+    assert mapping["blk.1.ffn_gate_exps.weight"].endswith(
+        ".block_sparse_moe.experts.0.w1.weight"
+    )
+    assert mapping["blk.1.ffn_down_exps.weight"].endswith(
+        ".block_sparse_moe.experts.0.w2.weight"
+    )
+    assert mapping["blk.1.ffn_up_exps.weight"].endswith(
+        ".block_sparse_moe.experts.0.w3.weight"
+    )
+
+
+def test_kimi_k3_inverse_transforms(monkeypatch):
+    adapter = KimiK3NeuronGGUFAdapter(_config())
+    adapter.load_spec = GGUFLoadSpec(
+        weights_source=["unused.gguf"],
+        gguf_to_hf_name_map={},
+        unquantized_modules=[],
+    )
+    stored_a = -torch.exp(torch.tensor([0.25, -0.5]))
+    fake_weights = [
+        ("model.layers.0.self_attention_res_proj.weight", torch.tensor([2.0, 3.0])),
+        ("model.layers.0.self_attn.A_log", stored_a),
+        ("__k3_conv__.0.q.weight", torch.arange(32.0).reshape(1, 8, 1, 4)),
+        ("__k3_kvb__.1.k.weight", torch.arange(24.0).reshape(2, 4, 3)),
+        ("__k3_kvb__.1.v.weight", torch.arange(24.0).reshape(2, 3, 4)),
+        (
+            "model.layers.1.block_sparse_moe.experts.0.w1.weight",
+            torch.arange(24.0).reshape(2, 3, 4),
+        ),
+    ]
+    monkeypatch.setattr(
+        "vllm_gguf_plugin.weights_adapter.kimi_k3.gguf_quant_weights_iterator_multi",
+        lambda *_args, **_kwargs: iter(fake_weights),
+    )
+
+    loaded = list(adapter.prepare_weights(None))
+    by_name = {name: weight for name, weight in loaded}
+    assert torch.equal(
+        by_name["model.layers.0.self_attention_res_norm.weight"], torch.ones(2)
+    )
+    assert by_name["model.layers.0.self_attention_res_proj.weight"].shape == (1, 2)
+    assert torch.allclose(by_name["model.layers.0.self_attn.A_log"], torch.tensor([0.25, -0.5]))
+    assert by_name["model.layers.0.self_attn.q_conv1d.weight"].shape == (8, 1, 4)
+    assert by_name["model.layers.1.self_attn.kv_b_proj.weight"].shape == (12, 4)
+    assert "model.layers.1.block_sparse_moe.experts.1.w1.weight" in by_name
+
+
+def test_situ_beta_plumbing_preserves_k3_values():
+    config = _situ_activation_config(4.0, 25.0)
+    assert config.activation_situ_beta == 4.0
+    assert config.activation_situ_linear_beta == 25.0
+    unset = _situ_activation_config(-1.0, -1.0)
+    assert unset.activation_situ_beta is None
+    assert unset.activation_situ_linear_beta is None
